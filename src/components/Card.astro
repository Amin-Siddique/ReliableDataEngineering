---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ogImage, ...props } = data;

// Get image URL
let imageUrl: string | undefined;
if (typeof ogImage === "string") {
  imageUrl = ogImage;
} else if (ogImage?.src) {
  imageUrl = ogImage.src;
}
---

<li class="my-6">
  <a
    href={getPath(id, filePath)}
    class="group flex flex-col gap-4 sm:flex-row sm:items-start"
  >
    {
      imageUrl && (
        <img
          src={imageUrl}
          alt={title}
          class="h-32 w-full rounded-lg object-cover sm:h-24 sm:w-40 flex-shrink-0 transition-opacity group-hover:opacity-80"
        />
      )
    }
    <div class="flex-1">
      <div class="flex items-start justify-between gap-2">
        <Heading
          class:list={[
            "text-lg font-medium text-accent",
            "decoration-dashed underline-offset-4 group-hover:underline",
          ]}
          style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
        >
          {title}
        </Heading>
        <span class="card-bookmark-indicator hidden flex-shrink-0 text-accent" data-card-slug={id}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" stroke="currentColor" stroke-width="2">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
          </svg>
        </span>
      </div>
      <Datetime {...props} />
      <p class="mt-1 text-foreground/80">{description}</p>
    </div>
  </a>
</li>

<script>
  function initCardIndicators() {
    // Show bookmark indicators for bookmarked articles
    function updateIndicators() {
      if (!window.__authUser) return;
      fetch("/api/bookmarks")
        .then(res => res.json())
        .then(data => {
          const slugs = new Set((data.bookmarks || []).map((b: { post_slug: string }) => b.post_slug));
          document.querySelectorAll<HTMLSpanElement>("[data-card-slug]").forEach(el => {
            el.classList.toggle("hidden", !slugs.has(el.dataset.cardSlug || ""));
          });
        })
        .catch(() => {});
    }

    window.addEventListener("auth:ready", updateIndicators);
  }

  // Only init once per page, not per card instance
  if (!(window as any).__cardIndicatorsInit) {
    (window as any).__cardIndicatorsInit = true;
    document.addEventListener("astro:page-load", initCardIndicators);
  }
</script>
