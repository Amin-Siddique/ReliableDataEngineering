---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="like-button-container" data-slug={slug}>
  <button class="like-button" aria-label="Like this article">
    <svg class="thumb-icon" viewBox="0 0 24 24" width="24" height="24">
      <path d="M2 20h2c.55 0 1-.45 1-1v-9c0-.55-.45-1-1-1H2v11zm19.83-7.12c.11-.25.17-.52.17-.8V11c0-1.1-.9-2-2-2h-5.5l.92-4.65c.05-.22.02-.46-.08-.66-.23-.45-.52-.86-.88-1.22L14 2 7.59 8.41C7.21 8.79 7 9.3 7 9.83v7.84C7 18.95 8.05 20 9.34 20h8.11c.7 0 1.36-.37 1.72-.97l2.66-6.15z"/>
    </svg>
    <span class="like-count">0</span>
  </button>
</div>

<style>
  .like-button-container {
    display: inline-flex;
    align-items: center;
    margin: 1rem 0;
  }

  .like-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-color, #374151);
    border-radius: 9999px;
    background: transparent;
    color: var(--text-color, #9ca3af);
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 0.875rem;
  }

  .like-button:hover {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  .like-button.liked {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  .like-button.liked .thumb-icon {
    fill: #3b82f6;
  }

  .thumb-icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    transition: fill 0.2s ease;
  }

  .like-count {
    font-weight: 500;
  }
</style>

<script>
  function getFingerprint(): string {
    const stored = localStorage.getItem("fp");
    if (stored) return stored;

    const fp = Math.random().toString(36).substring(2) + Date.now().toString(36);
    localStorage.setItem("fp", fp);
    return fp;
  }

  function initLikeButtons() {
    const containers = document.querySelectorAll<HTMLDivElement>(".like-button-container:not([data-initialized])");

    containers.forEach(container => {
      container.dataset.initialized = "true";

      const slug = container.dataset.slug;
      if (!slug) return;

      const button = container.querySelector<HTMLButtonElement>(".like-button");
      const countSpan = container.querySelector<HTMLSpanElement>(".like-count");
      if (!button || !countSpan) return;

      const fp = getFingerprint();

      // Fetch initial state
      fetch(`/api/likes?slug=${encodeURIComponent(slug)}&fp=${encodeURIComponent(fp)}`)
        .then(res => res.json())
        .then(data => {
          countSpan.textContent = data.count.toString();
          if (data.hasLiked) {
            button.classList.add("liked");
          }
        })
        .catch(console.error);

      // Handle click
      button.addEventListener("click", async () => {
        button.disabled = true;

        try {
          const res = await fetch(`/api/likes?slug=${encodeURIComponent(slug)}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ fingerprint: fp }),
          });

          const data = await res.json();
          countSpan.textContent = data.count.toString();
          button.classList.toggle("liked", data.hasLiked);
        } catch (err) {
          console.error(err);
        } finally {
          button.disabled = false;
        }
      });
    });
  }

  // Run on initial load and after Astro page transitions
  document.addEventListener("astro:page-load", initLikeButtons);
</script>
