---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="comments-section" data-slug={slug}>
  <h3 class="comments-title text-foreground">Comments</h3>

  <form class="comment-form">
    <div class="form-group comment-name-group">
      <input
        type="text"
        name="authorName"
        placeholder="Your name"
        maxlength="100"
        required
      />
    </div>
    <div class="form-group">
      <textarea
        name="content"
        placeholder="Write a comment..."
        maxlength="2000"
        rows="4"
        required
      ></textarea>
    </div>
    <input type="hidden" name="parentId" value="" />
    <div class="form-actions">
      <button type="submit" class="submit-btn">Post Comment</button>
      <button type="button" class="cancel-reply-btn hidden">Cancel Reply</button>
    </div>
    <p class="reply-indicator hidden"></p>
    <p class="form-error"></p>
  </form>

  <div class="comments-list">
    <p class="loading text-foreground/70">Loading comments...</p>
  </div>
</div>

<style>
  .comments-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .comments-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .comment-form {
    margin-bottom: 2rem;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .comment-form input,
  .comment-form textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--background);
    color: var(--foreground);
    font-family: inherit;
    font-size: 0.875rem;
  }

  .comment-form input:focus,
  .comment-form textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .submit-btn {
    padding: 0.625rem 1.25rem;
    background: var(--accent);
    color: var(--background);
    border: none;
    border-radius: 0.5rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .submit-btn:hover {
    opacity: 0.9;
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .cancel-reply-btn {
    padding: 0.625rem 1.25rem;
    background: transparent;
    color: var(--foreground);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    font-weight: 500;
    cursor: pointer;
    font-size: 0.875rem;
  }

  .reply-indicator {
    font-size: 0.8125rem;
    color: var(--accent);
    margin-top: 0.5rem;
  }

  .form-error {
    color: #ef4444;
    font-size: 0.875rem;
    margin-top: 0.5rem;
    display: none;
  }

  .form-error.visible {
    display: block;
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .loading {
    font-style: italic;
  }

  .no-comments {
    color: var(--foreground);
    opacity: 0.6;
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  interface Comment {
    id: number;
    author_name: string;
    content: string;
    created_at: string;
    updated_at: string | null;
    parent_id: number | null;
    user_id: number | null;
    user_display_name: string | null;
    user_avatar_url: string | null;
    user_provider: string | null;
  }

  function escapeHtml(text: string): string {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  function formatDate(dateStr: string): string {
    return new Date(dateStr).toLocaleDateString("en-US", {
      year: "numeric", month: "short", day: "numeric",
    });
  }

  function renderComment(comment: Comment, currentUserId: number | null, depth: number = 0): string {
    const displayName = comment.user_display_name || comment.author_name;
    const avatarUrl = comment.user_avatar_url
      || `https://ui-avatars.com/api/?name=${encodeURIComponent(displayName)}&background=374151&color=9ca3af&size=40`;
    const isOwn = currentUserId && comment.user_id === currentUserId;
    const isVerified = !!comment.user_id;
    const edited = comment.updated_at ? ' <span style="font-size:0.7rem;opacity:0.5">(edited)</span>' : "";
    const indent = Math.min(depth, 3) * 1.5;

    return `
      <div class="comment" data-comment-id="${comment.id}" style="margin-left: ${indent}rem">
        <div class="comment-header" style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem">
          <img src="${escapeHtml(avatarUrl)}" alt="" width="28" height="28"
               style="border-radius:50%;flex-shrink:0" />
          <div style="flex:1;display:flex;align-items:baseline;gap:0.5rem;flex-wrap:wrap">
            <span style="font-weight:600;font-size:0.875rem;color:var(--foreground)">${escapeHtml(displayName)}</span>
            ${isVerified ? '<span style="font-size:0.65rem;background:var(--accent);color:var(--background);padding:0.1rem 0.35rem;border-radius:0.25rem">verified</span>' : ""}
            <span style="font-size:0.75rem;opacity:0.5">${formatDate(comment.created_at)}${edited}</span>
          </div>
        </div>
        <div style="color:var(--foreground);opacity:0.85;line-height:1.6;white-space:pre-wrap;word-break:break-word;font-size:0.875rem;padding-left:2.25rem">
          ${escapeHtml(comment.content)}
        </div>
        <div style="padding-left:2.25rem;margin-top:0.5rem;display:flex;gap:0.75rem;align-items:center">
          <button class="comment-like-btn" data-like-id="${comment.id}"
                  style="background:none;border:none;display:inline-flex;align-items:center;gap:0.25rem;font-size:0.75rem;cursor:pointer;padding:0;color:var(--foreground);opacity:0.5;transition:all 0.15s"
                  title="Like this comment">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span class="comment-like-count">0</span>
          </button>
          <button class="reply-btn" data-reply-id="${comment.id}" data-reply-name="${escapeHtml(displayName)}"
                  style="background:none;border:none;color:var(--accent);font-size:0.75rem;cursor:pointer;padding:0">Reply</button>
          ${isOwn ? `
            <button class="edit-btn" data-edit-id="${comment.id}"
                    style="background:none;border:none;color:var(--foreground);opacity:0.5;font-size:0.75rem;cursor:pointer;padding:0">Edit</button>
            <button class="delete-btn" data-delete-id="${comment.id}"
                    style="background:none;border:none;color:#ef4444;opacity:0.6;font-size:0.75rem;cursor:pointer;padding:0">Delete</button>
          ` : ""}
        </div>
      </div>
    `;
  }

  function buildCommentTree(comments: Comment[], currentUserId: number | null): string {
    const rootComments = comments.filter(c => !c.parent_id);
    const childMap = new Map<number, Comment[]>();

    comments.forEach(c => {
      if (c.parent_id) {
        const children = childMap.get(c.parent_id) || [];
        children.push(c);
        childMap.set(c.parent_id, children);
      }
    });

    function renderTree(comment: Comment, depth: number): string {
      let html = renderComment(comment, currentUserId, depth);
      const children = childMap.get(comment.id) || [];
      children.forEach(child => {
        html += renderTree(child, depth + 1);
      });
      return html;
    }

    return rootComments.map(c => renderTree(c, 0)).join("");
  }

  function initComments() {
    const sections = document.querySelectorAll<HTMLDivElement>(".comments-section:not([data-initialized])");

    sections.forEach(section => {
      section.dataset.initialized = "true";

      const slug = section.dataset.slug || "";
      if (!slug) return;

      const form = section.querySelector<HTMLFormElement>(".comment-form")!;
      const list = section.querySelector<HTMLDivElement>(".comments-list")!;
      const errorEl = section.querySelector<HTMLParagraphElement>(".form-error")!;
      const nameGroup = section.querySelector<HTMLDivElement>(".comment-name-group")!;
      const nameInput = section.querySelector<HTMLInputElement>('[name="authorName"]')!;
      const parentInput = section.querySelector<HTMLInputElement>('[name="parentId"]')!;
      const cancelReplyBtn = section.querySelector<HTMLButtonElement>(".cancel-reply-btn")!;
      const replyIndicator = section.querySelector<HTMLParagraphElement>(".reply-indicator")!;

      let allComments: Comment[] = [];
      let currentUserId: number | null = null;

      // Like state
      let likeCounts: Record<number, number> = {};
      let userLikes: Set<number> = new Set();

      // Hide name field if authenticated
      function updateFormForAuth() {
        if (window.__authUser) {
          nameGroup.classList.add("hidden");
          nameInput.removeAttribute("required");
        } else {
          nameGroup.classList.remove("hidden");
          nameInput.setAttribute("required", "");
        }
      }

      window.addEventListener("auth:ready", () => updateFormForAuth());
      if (window.__authUser !== undefined) updateFormForAuth();

      function fetchCommentLikes() {
        fetch(`/api/comment-likes?slug=${encodeURIComponent(slug)}`)
          .then(res => res.json())
          .then(data => {
            likeCounts = data.counts || {};
            userLikes = new Set(data.userLikes || []);
            updateLikeButtons();
          })
          .catch(() => {});
      }

      function updateLikeButtons() {
        list.querySelectorAll<HTMLButtonElement>(".comment-like-btn").forEach(btn => {
          const id = parseInt(btn.dataset.likeId || "0");
          const count = likeCounts[id] || 0;
          const liked = userLikes.has(id);

          const countEl = btn.querySelector<HTMLSpanElement>(".comment-like-count");
          if (countEl) countEl.textContent = count > 0 ? count.toString() : "";

          const svg = btn.querySelector("svg");
          if (liked) {
            btn.style.color = "#ef4444";
            btn.style.opacity = "1";
            if (svg) {
              svg.setAttribute("fill", "#ef4444");
              svg.setAttribute("stroke", "#ef4444");
            }
          } else {
            btn.style.color = "var(--foreground)";
            btn.style.opacity = "0.5";
            if (svg) {
              svg.setAttribute("fill", "none");
              svg.setAttribute("stroke", "currentColor");
            }
          }
        });
      }

      function refreshComments() {
        list.innerHTML = allComments.length === 0
          ? '<p class="no-comments">No comments yet. Be the first to comment!</p>'
          : buildCommentTree(allComments, currentUserId);

        // Update like button states
        updateLikeButtons();

        // Bind like buttons
        list.querySelectorAll<HTMLButtonElement>(".comment-like-btn").forEach(btn => {
          btn.addEventListener("click", async () => {
            if (!window.__authUser) {
              alert("Sign in to like comments");
              return;
            }

            const id = parseInt(btn.dataset.likeId || "0");

            try {
              const res = await fetch("/api/comment-likes", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ commentId: id }),
              });
              const data = await res.json();

              if (!res.ok) {
                if (data.error) alert(data.error);
                return;
              }

              likeCounts[id] = data.count;
              if (data.hasLiked) {
                userLikes.add(id);
              } else {
                userLikes.delete(id);
              }
              updateLikeButtons();
            } catch {
              // silently fail
            }
          });
        });

        // Bind reply buttons
        list.querySelectorAll<HTMLButtonElement>(".reply-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            parentInput.value = btn.dataset.replyId || "";
            replyIndicator.textContent = `Replying to ${btn.dataset.replyName}`;
            replyIndicator.classList.remove("hidden");
            cancelReplyBtn.classList.remove("hidden");
            form.querySelector("textarea")?.focus();
          });
        });

        // Bind edit buttons
        list.querySelectorAll<HTMLButtonElement>(".edit-btn").forEach(btn => {
          btn.addEventListener("click", async () => {
            const id = parseInt(btn.dataset.editId || "0");
            const comment = allComments.find(c => c.id === id);
            if (!comment) return;

            const newContent = prompt("Edit your comment:", comment.content);
            if (newContent === null || newContent.trim() === "") return;

            try {
              const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ commentId: id, content: newContent }),
              });
              if (res.ok) {
                const data = await res.json();
                const idx = allComments.findIndex(c => c.id === id);
                if (idx >= 0) {
                  allComments[idx] = { ...allComments[idx], ...data.comment };
                  refreshComments();
                }
              }
            } catch (err) { console.error(err); }
          });
        });

        // Bind delete buttons
        list.querySelectorAll<HTMLButtonElement>(".delete-btn").forEach(btn => {
          btn.addEventListener("click", async () => {
            if (!confirm("Delete this comment?")) return;
            const id = parseInt(btn.dataset.deleteId || "0");

            try {
              const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`, {
                method: "DELETE",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ commentId: id }),
              });
              if (res.ok) {
                allComments = allComments.filter(c => c.id !== id && c.parent_id !== id);
                refreshComments();
              }
            } catch (err) { console.error(err); }
          });
        });
      }

      // Cancel reply
      cancelReplyBtn.addEventListener("click", () => {
        parentInput.value = "";
        replyIndicator.classList.add("hidden");
        cancelReplyBtn.classList.add("hidden");
      });

      // Fetch comments
      fetch(`/api/comments?slug=${encodeURIComponent(slug)}`)
        .then(res => res.json())
        .then(data => {
          allComments = data.comments || [];
          currentUserId = data.currentUserId;
          refreshComments();
          fetchCommentLikes();
        })
        .catch(() => {
          list.innerHTML = '<p class="no-comments">Failed to load comments.</p>';
        });

      // Handle form submit
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const authorName = formData.get("authorName") as string;
        const content = formData.get("content") as string;
        const parentId = formData.get("parentId") as string;

        const submitBtn = form.querySelector<HTMLButtonElement>(".submit-btn")!;
        submitBtn.disabled = true;
        errorEl.classList.remove("visible");

        try {
          const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              authorName: window.__authUser ? undefined : authorName,
              content,
              parentId: parentId ? parseInt(parentId) : undefined,
            }),
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || "Failed to post comment");
          }

          allComments.push(data.comment);
          refreshComments();
          form.reset();
          parentInput.value = "";
          replyIndicator.classList.add("hidden");
          cancelReplyBtn.classList.add("hidden");
        } catch (err) {
          errorEl.textContent = err instanceof Error ? err.message : "Failed to post comment";
          errorEl.classList.add("visible");
        } finally {
          submitBtn.disabled = false;
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initComments);
</script>
