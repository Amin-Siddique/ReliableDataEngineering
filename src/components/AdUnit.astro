---
type Props = {
  slot: "header" | "in-article" | "sidebar" | "footer";
  class?: string;
};

const { slot, class: className } = Astro.props;
---

<!-- Ad slot: {slot} — replace data-ad-slot with real AdSense/Carbon IDs once approved -->
<div
  class:list={[
    "ad-unit my-6 flex items-center justify-center",
    className,
  ]}
  data-ad-slot={slot}
>
