---
type Props = {
  slot: "header" | "in-article" | "sidebar" | "footer";
  class?: string;
};

const { slot, class: className } = Astro.props;
---

<!-- Ad slot: {slot} -->
<div
  class:list={[
    "ad-unit my-6 flex items-center justify-center",
    className,
  ]}
  data-ad-slot={slot}
>
  <!-- Google AdSense - Auto ads will display once approved -->
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-9040516721758437"
    data-ad-slot="auto"
    data-ad-format="auto"
    data-full-width-responsive="true"
  ></ins>
  <script is:inline data-astro-rerun>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>
