---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  posts: CollectionEntry<"blog">[];
};

const { posts } = Astro.props;
---

<aside class="trending-sidebar" data-trending>
  <h3 class="trending-heading">Trending</h3>
  <ol class="trending-list" id="trending-list">
    {posts.slice(0, 5).map((post, i) => {
      const dt = dayjs(post.data.modDatetime ?? post.data.pubDatetime).tz(SITE.timezone);
      return (
        <li class="trending-item" data-slug={post.id}>
          <span class="trending-number">{String(i + 1).padStart(2, "0")}</span>
          <div class="trending-body">
            <a href={getPath(post.id, post.filePath)} class="trending-link">
              {post.data.title}
            </a>
            <div class="trending-meta">
              <time datetime={dt.toISOString()}>{dt.format("MMM D")}</time>
              <span class="trending-views"></span>
            </div>
          </div>
        </li>
      );
    })}
  </ol>
  {/* Hidden data for all posts so JS can reorder */}
  <template id="trending-data">
    {posts.map(post => {
      const dt = dayjs(post.data.modDatetime ?? post.data.pubDatetime).tz(SITE.timezone);
      return (
        <div
          data-slug={post.id}
          data-title={post.data.title}
          data-href={getPath(post.id, post.filePath)}
          data-date={dt.format("MMM D")}
          data-iso={dt.toISOString()}
        />
      );
    })}
  </template>
</aside>

<style is:global>
  .trending-sidebar {
    margin-bottom: 2rem;
  }

  .trending-sidebar .trending-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--foreground);
    display: inline-block;
  }

  .trending-sidebar .trending-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .trending-sidebar .trending-item {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .trending-sidebar .trending-item:first-child {
    padding-top: 0;
  }

  .trending-sidebar .trending-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .trending-sidebar .trending-number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--foreground);
    opacity: 0.08;
    line-height: 1;
    flex-shrink: 0;
    width: 2rem;
    text-align: center;
  }

  .trending-sidebar .trending-body {
    flex: 1;
    min-width: 0;
    padding-top: 0.125rem;
  }

  .trending-sidebar .trending-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--foreground);
    text-decoration: none;
    line-height: 1.4;
    display: block;
  }

  .trending-sidebar .trending-link:hover {
    color: var(--accent);
  }

  .trending-sidebar .trending-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    color: var(--foreground);
    opacity: 0.4;
    margin-top: 0.375rem;
  }

  .trending-sidebar .trending-dot {
    width: 3px;
    height: 3px;
    background: currentColor;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .trending-sidebar .trending-views {
    font-size: 0.6875rem;
  }
</style>

<script>
  function initTrending() {
    const list = document.getElementById("trending-list");
    const tpl = document.getElementById("trending-data") as HTMLTemplateElement | null;
    if (!list || !tpl) return;

    fetch("/api/trending")
      .then(res => res.json())
      .then(data => {
        const slugs: { post_slug: string; count: number }[] = data.trending || [];
        if (slugs.length === 0) return;

        // Build a map of slug -> post info from the template
        const postMap = new Map<string, { title: string; href: string; date: string; iso: string }>();
        tpl.content.querySelectorAll("[data-slug]").forEach(el => {
          const e = el as HTMLElement;
          postMap.set(e.dataset.slug!, {
            title: e.dataset.title!,
            href: e.dataset.href!,
            date: e.dataset.date!,
            iso: e.dataset.iso!,
          });
        });

        // Build reordered list from view counts
        const items = slugs
          .filter(s => postMap.has(s.post_slug))
          .slice(0, 5);

        if (items.length === 0) return;

        list.innerHTML = items
          .map((item, i) => {
            const p = postMap.get(item.post_slug)!;
            const views = item.count >= 1000
              ? (item.count / 1000).toFixed(1) + "K"
              : item.count.toString();
            return `
              <li class="trending-item">
                <span class="trending-number">${String(i + 1).padStart(2, "0")}</span>
                <div class="trending-body">
                  <a href="${p.href}" class="trending-link">${p.title}</a>
                  <div class="trending-meta">
                    <time datetime="${p.iso}">${p.date}</time>
                    <span class="trending-dot"></span>
                    <span class="trending-views">${views} views</span>
                  </div>
                </div>
              </li>
            `;
          })
          .join("");
      })
      .catch(() => {});
  }

  document.addEventListener("astro:page-load", initTrending);
</script>
