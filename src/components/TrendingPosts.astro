---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  posts: CollectionEntry<"blog">[];
};

const { posts } = Astro.props;

// Show featured first, then most recent — up to 5
const featured = posts.filter(p => p.data.featured);
const nonFeatured = posts.filter(p => !p.data.featured);
const trending = [...featured, ...nonFeatured].slice(0, 5);
---

<aside class="trending-sidebar">
  <h3 class="trending-heading">Trending</h3>
  <ol class="trending-list">
    {trending.map((post, i) => {
      const dt = dayjs(post.data.modDatetime ?? post.data.pubDatetime).tz(SITE.timezone);
      return (
        <li class="trending-item">
          <span class="trending-number">{String(i + 1).padStart(2, "0")}</span>
          <div class="trending-body">
            <a href={getPath(post.id, post.filePath)} class="trending-link">
              {post.data.title}
            </a>
            <div class="trending-meta">
              <span>{post.data.author}</span>
              <span class="trending-dot" aria-hidden="true" />
              <time datetime={dt.toISOString()}>{dt.format("MMM D")}</time>
            </div>
          </div>
        </li>
      );
    })}
  </ol>
</aside>

<style>
  .trending-sidebar {
    margin-bottom: 2rem;
  }

  .trending-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .trending-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .trending-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .trending-number {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--foreground);
    opacity: 0.12;
    line-height: 1;
    flex-shrink: 0;
    min-width: 1.75rem;
  }

  .trending-body {
    min-width: 0;
  }

  .trending-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--foreground);
    text-decoration: none;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .trending-link:hover {
    color: var(--accent);
  }

  .trending-meta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--foreground);
    opacity: 0.45;
    margin-top: 0.25rem;
  }

  .trending-dot {
    width: 3px;
    height: 3px;
    background: currentColor;
    border-radius: 50%;
  }
</style>
