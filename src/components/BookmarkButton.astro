---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="bookmark-container" data-bookmark-slug={slug}>
  <button class="bookmark-btn" aria-label="Bookmark this article">
    <svg class="bookmark-icon-outline" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
    </svg>
    <svg class="bookmark-icon-filled hidden" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" stroke="currentColor" stroke-width="2">
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="bookmark-text">Save</span>
  </button>
</div>

<style>
  .bookmark-container {
    display: inline-flex;
    align-items: center;
  }

  .bookmark-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--foreground);
    opacity: 0.7;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .bookmark-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    opacity: 1;
  }

  .bookmark-btn.bookmarked {
    border-color: var(--accent);
    color: var(--accent);
    opacity: 1;
  }

  .hidden {
    display: none;
  }
</style>

<script>
  function initBookmarkButtons() {
    const containers = document.querySelectorAll<HTMLDivElement>("[data-bookmark-slug]:not([data-bm-initialized])");

    containers.forEach(container => {
      container.dataset.bmInitialized = "true";

      const slug = container.dataset.bookmarkSlug || "";
      if (!slug) return;

      const btn = container.querySelector<HTMLButtonElement>(".bookmark-btn")!;
      const outlineIcon = container.querySelector<SVGElement>(".bookmark-icon-outline")!;
      const filledIcon = container.querySelector<SVGElement>(".bookmark-icon-filled")!;
      const text = container.querySelector<HTMLSpanElement>(".bookmark-text")!;

      function setBookmarked(isBookmarked: boolean) {
        btn.classList.toggle("bookmarked", isBookmarked);
        outlineIcon.classList.toggle("hidden", isBookmarked);
        filledIcon.classList.toggle("hidden", !isBookmarked);
        text.textContent = isBookmarked ? "Saved" : "Save";
      }

      // Check initial state once auth is ready
      function checkBookmark() {
        if (!window.__authUser) return;
        fetch(`/api/bookmarks?slug=${encodeURIComponent(slug)}`)
          .then(res => res.json())
          .then(data => {
            if (data.bookmarked) setBookmarked(true);
          })
          .catch(() => {});
      }

      if (window.__authUser !== undefined) {
        checkBookmark();
      }
      window.addEventListener("auth:ready", () => checkBookmark());

      // Toggle bookmark
      btn.addEventListener("click", async () => {
        if (!window.__authUser) {
          // Prompt to sign in
          const signInBtn = document.querySelector<HTMLButtonElement>(".auth-sign-in-btn");
          if (signInBtn) signInBtn.click();
          return;
        }

        btn.disabled = true;
        try {
          const res = await fetch("/api/bookmarks", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ slug }),
          });
          const data = await res.json();
          setBookmarked(data.bookmarked);
        } catch (err) {
          console.error(err);
        } finally {
          btn.disabled = false;
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initBookmarkButtons);
</script>
