---
interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
---

<button class="bookmark-btn" data-slug={slug} data-title={title} aria-label="Bookmark this article">
  <svg class="bookmark-icon" viewBox="0 0 24 24" width="18" height="18">
    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
  </svg>
  <span class="btn-text">Save</span>
</button>

<style>
  .bookmark-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-color, #374151);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--text-muted, #9ca3af);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .bookmark-btn:hover {
    border-color: #f59e0b;
    color: #f59e0b;
  }

  .bookmark-btn.bookmarked {
    border-color: #f59e0b;
    color: #f59e0b;
  }

  .bookmark-btn.bookmarked .bookmark-icon {
    fill: #f59e0b;
  }

  .bookmark-icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transition: fill 0.2s;
  }
</style>

<script>
  interface Bookmark {
    slug: string;
    title: string;
    savedAt: string;
  }

  function getBookmarks(): Bookmark[] {
    try {
      return JSON.parse(localStorage.getItem("bookmarks") || "[]");
    } catch {
      return [];
    }
  }

  function saveBookmarks(bookmarks: Bookmark[]) {
    localStorage.setItem("bookmarks", JSON.stringify(bookmarks));
  }

  function initBookmarkButtons() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".bookmark-btn:not([data-initialized])");

    buttons.forEach(button => {
      button.dataset.initialized = "true";

      const slug = button.dataset.slug;
      const title = button.dataset.title;
      if (!slug || !title) return;

      const btnText = button.querySelector<HTMLSpanElement>(".btn-text");

      // Check if already bookmarked
      const bookmarks = getBookmarks();
      const isBookmarked = bookmarks.some(b => b.slug === slug);

      if (isBookmarked) {
        button.classList.add("bookmarked");
        if (btnText) btnText.textContent = "Saved";
      }

      button.addEventListener("click", () => {
        const bookmarks = getBookmarks();
        const existingIndex = bookmarks.findIndex(b => b.slug === slug);

        if (existingIndex > -1) {
          // Remove bookmark
          bookmarks.splice(existingIndex, 1);
          button.classList.remove("bookmarked");
          if (btnText) btnText.textContent = "Save";
        } else {
          // Add bookmark
          bookmarks.unshift({ slug, title, savedAt: new Date().toISOString() });
          button.classList.add("bookmarked");
          if (btnText) btnText.textContent = "Saved";
        }

        saveBookmarks(bookmarks);
      });
    });
  }

  document.addEventListener("astro:page-load", initBookmarkButtons);
</script>
