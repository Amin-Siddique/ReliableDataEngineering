---

---

<!-- Guest welcome (shown to non-authenticated visitors) -->
<div id="welcome-guest" class="wb-hidden mb-6" data-welcome-guest>
  <div class="wb-guest-box">
    <div class="wb-guest-content">
      <p class="wb-guest-heading">👋 Welcome to Reliable Data Engineering</p>
      <p class="wb-guest-text">
        Glad you're here! Sign up to bookmark articles, highlight passages,
        leave notes other readers can see, and pick up where you left off.
      </p>
      <div class="wb-guest-features">
        <span class="wb-feature">📑 Bookmarks</span>
        <span class="wb-feature">🖍️ Highlights & Notes</span>
        <span class="wb-feature">💬 Comments</span>
        <span class="wb-feature">📖 Reading History</span>
      </div>
    </div>
    <div class="wb-guest-actions">
      <div class="wb-auth-options">
        <a href="/api/auth/google" class="wb-auth-btn" title="Sign up with Google">
          <svg viewBox="0 0 24 24" width="16" height="16"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        </a>
        <a href="/api/auth/github" class="wb-auth-btn" title="Sign up with GitHub">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <button id="wb-email-signup" class="wb-auth-btn" title="Sign up with Email">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
        </button>
      </div>
      <button id="wb-dismiss" class="wb-dismiss-btn" aria-label="Dismiss">✕</button>
    </div>
  </div>
</div>

<!-- Authenticated welcome (shown to signed-in users) -->
<div id="welcome-banner" class="wb-hidden mb-6 rounded-lg border border-border bg-muted/30 p-5" data-welcome>
  <div class="flex items-center gap-4">
    <img id="welcome-avatar" alt="" width="48" height="48"
         class="rounded-full border border-border object-cover flex-shrink-0" />
    <div class="flex-1 min-w-0">
      <p class="text-lg font-semibold text-foreground">
        Welcome back, <span id="welcome-name"></span>
      </p>
      <div id="welcome-stats" class="flex flex-wrap gap-4 mt-1 text-xs text-foreground/60">
        <a href="/history" class="hover:text-accent transition-colors"><strong id="welcome-read" class="text-foreground/80">0</strong> articles read</a>
        <a href="/bookmarks" class="hover:text-accent transition-colors"><strong id="welcome-bookmarks" class="text-foreground/80">0</strong> bookmarks</a>
        <span><strong id="welcome-comments" class="text-foreground/80">0</strong> comments</span>
      </div>
    </div>
    <a href="/profile" class="flex-shrink-0 text-xs text-accent hover:underline hidden sm:block">View profile</a>
  </div>
</div>

<style>
  .wb-hidden {
    display: none !important;
  }

  .wb-guest-box {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 6%, var(--background)), var(--background));
  }

  .wb-guest-content {
    flex: 1;
    min-width: 0;
  }

  .wb-guest-heading {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 0.375rem;
  }

  .wb-guest-text {
    font-size: 0.8125rem;
    color: var(--foreground);
    opacity: 0.7;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .wb-guest-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .wb-feature {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--foreground);
    opacity: 0.55;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    white-space: nowrap;
  }

  .wb-guest-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    flex-shrink: 0;
    padding-top: 0.125rem;
  }

  .wb-auth-options {
    display: flex;
    gap: 0.375rem;
  }

  .wb-auth-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--background);
    color: var(--foreground);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .wb-auth-btn:hover {
    border-color: var(--accent);
  }

  .wb-dismiss-btn {
    background: none;
    border: none;
    color: var(--foreground);
    opacity: 0.3;
    font-size: 0.75rem;
    cursor: pointer;
    padding: 0.25rem;
    line-height: 1;
  }

  .wb-dismiss-btn:hover {
    opacity: 0.7;
  }

  @media (max-width: 639px) {
    .wb-guest-box {
      flex-direction: column;
      gap: 1rem;
    }

    .wb-guest-actions {
      flex-direction: row-reverse;
      width: 100%;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>

<script>
  function initWelcomeBanner() {
    const banner = document.getElementById("welcome-banner");
    const guest = document.getElementById("welcome-guest");
    const dismissBtn = document.getElementById("wb-dismiss");

    if ((!banner && !guest) || banner?.dataset.wInit === "true") return;
    if (banner) banner.dataset.wInit = "true";

    const dismissed = localStorage.getItem("wb-dismissed") === "true";

    function showUser(user: typeof window.__authUser) {
      if (!user || !banner) return;

      // Hide guest banner
      guest?.classList.add("wb-hidden");

      const avatarSrc = user.avatarUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(user.displayName)}&background=3b82f6&color=fff&size=96`;
      (document.getElementById("welcome-avatar") as HTMLImageElement).src = avatarSrc;
      document.getElementById("welcome-name")!.textContent = user.displayName;

      banner.classList.remove("wb-hidden");

      // Fetch stats
      fetch("/api/profile")
        .then(res => res.json())
        .then(data => {
          if (data.stats) {
            document.getElementById("welcome-read")!.textContent = data.stats.articlesRead.toString();
            document.getElementById("welcome-bookmarks")!.textContent = data.stats.bookmarks.toString();
            document.getElementById("welcome-comments")!.textContent = data.stats.comments.toString();
          }
        })
        .catch(() => {});
    }

    function showGuest() {
      banner?.classList.add("wb-hidden");
      if (!dismissed && guest) {
        guest.classList.remove("wb-hidden");
      }
    }

    // Email signup button opens the auth email modal in signup mode
    document.getElementById("wb-email-signup")?.addEventListener("click", () => {
      const modal = document.querySelector<HTMLDivElement>("[data-email-modal]");
      if (modal) {
        modal.classList.remove("hidden");
        // Switch to signup mode
        const switchBtn = modal.querySelector<HTMLButtonElement>('[data-switch="signup"]');
        if (switchBtn) switchBtn.click();
      }
    });

    dismissBtn?.addEventListener("click", () => {
      guest?.classList.add("wb-hidden");
      localStorage.setItem("wb-dismissed", "true");
    });

    window.addEventListener("auth:ready", (e: Event) => {
      const user = (e as CustomEvent).detail;
      if (user) {
        showUser(user);
      } else {
        showGuest();
      }
    });

    window.addEventListener("auth:logout", () => {
      banner?.classList.add("wb-hidden");
      if (!dismissed) guest?.classList.remove("wb-hidden");
    });

    if (window.__authUser !== undefined) {
      if (window.__authUser) {
        showUser(window.__authUser);
      } else {
        showGuest();
      }
    }
  }

  document.addEventListener("astro:page-load", initWelcomeBanner);
</script>
