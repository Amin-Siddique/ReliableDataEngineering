---
type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<div
  class:list={[
    "newsletter-signup my-8 rounded-lg border border-border bg-muted/30 p-6 text-center",
    className,
  ]}
>
  <h3 class="mb-2 text-lg font-semibold">Stay in the loop</h3>
  <p class="mb-4 text-sm text-foreground/70">
    Get weekly data engineering insights delivered to your inbox. No spam.
  </p>
  <!-- Replace action URL with Buttondown or your newsletter provider -->
  <form
    action="https://buttondown.com/api/emails/embed-subscribe/reliable-data-engineering"
    method="post"
    target="popupwindow"
    class="flex flex-col items-center gap-2 sm:flex-row sm:justify-center"
  >
    <input
      type="email"
      name="email"
      placeholder="you@example.com"
      required
      class="w-full rounded border border-border bg-background px-4 py-2 text-sm sm:w-64"
    />
    <button
      type="submit"
      class="rounded bg-accent px-6 py-2 text-sm font-medium text-background transition-opacity hover:opacity-90"
    >
      Subscribe
    </button>
  </form>
</div>
