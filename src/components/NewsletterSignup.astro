---
type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<div
  class:list={[
    "newsletter-signup my-8 rounded-lg border border-border bg-muted/30 p-6 text-center",
    className,
  ]}
  data-newsletter
>
  <h3 class="mb-2 text-lg font-semibold">Stay in the loop</h3>
  <p class="mb-4 text-sm text-foreground/70">
    Get notified when new articles drop. No spam. Unsubscribe anytime.
  </p>

  <form class="newsletter-form mx-auto flex max-w-md flex-col gap-2 sm:flex-row">
    <input
      type="email"
      name="email"
      placeholder="your@email.com"
      required
      class="min-w-0 flex-1 rounded-md border border-border bg-background px-4 py-2 text-sm text-foreground focus:border-accent focus:outline-none"
    />
    <button
      type="submit"
      class="shrink-0 rounded-md bg-accent px-5 py-2 text-sm font-medium text-background transition-opacity hover:opacity-90 disabled:opacity-50"
    >
      Subscribe
    </button>
  </form>

  <p class="newsletter-message mt-3 text-sm hidden"></p>
  <p class="newsletter-error mt-3 text-sm text-red-400 hidden"></p>
</div>

<script>
  function initNewsletterForms() {
    const signups = document.querySelectorAll<HTMLDivElement>("[data-newsletter]:not([data-nl-initialized])");

    signups.forEach(signup => {
      signup.dataset.nlInitialized = "true";

      const form = signup.querySelector<HTMLFormElement>(".newsletter-form")!;
      const message = signup.querySelector<HTMLParagraphElement>(".newsletter-message")!;
      const error = signup.querySelector<HTMLParagraphElement>(".newsletter-error")!;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const emailInput = form.querySelector<HTMLInputElement>('[name="email"]')!;
        const submitBtn = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
        const email = emailInput.value.trim();

        if (!email) return;

        submitBtn.disabled = true;
        message.classList.add("hidden");
        error.classList.add("hidden");

        try {
          const res = await fetch("/api/newsletter", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || "Failed to subscribe");
          }

          message.textContent = data.message;
          message.classList.remove("hidden");
          message.style.color = "var(--accent)";
          form.reset();
        } catch (err) {
          error.textContent = err instanceof Error ? err.message : "Something went wrong";
          error.classList.remove("hidden");
        } finally {
          submitBtn.disabled = false;
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initNewsletterForms);
</script>
