---
---

<div
  id="cookie-consent"
  class="fixed bottom-0 left-0 right-0 z-50 hidden border-t border-border bg-background/95 backdrop-blur-sm"
>
  <div class="mx-auto max-w-5xl px-4 py-4 sm:flex sm:items-center sm:justify-between sm:gap-4">
    <p class="text-sm text-foreground/80 mb-3 sm:mb-0">
      This site uses cookies for analytics and advertising (Google Analytics, Google AdSense).
      By continuing to use this site, you consent to our use of cookies.
      <a href="/cookie-policy" class="text-accent hover:underline">Learn more</a>.
    </p>
    <div class="flex gap-3 shrink-0">
      <button
        id="cookie-reject"
        class="rounded border border-border px-4 py-1.5 text-sm text-foreground/70 transition-colors hover:border-accent hover:text-foreground"
      >
        Reject
      </button>
      <button
        id="cookie-accept"
        class="rounded bg-accent px-4 py-1.5 text-sm font-medium text-background transition-opacity hover:opacity-90"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var consent = localStorage.getItem("cookie-consent");

    if (!consent) {
      var banner = document.getElementById("cookie-consent");
      if (banner) banner.classList.remove("hidden");
    }

    function loadAnalytics() {
      // Load AdSense only on pages that opt in to ads (they preconnect to googlesyndication)
      if (document.querySelector('link[href*="googlesyndication"]') && !document.querySelector('script[src*="adsbygoogle"]')) {
        var s = document.createElement('script');
        s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9040516721758437';
        s.async = true;
        s.crossOrigin = 'anonymous';
        document.head.appendChild(s);
      }
      // Load GA if not already present
      if (!document.querySelector('script[src*="googletagmanager"]')) {
        var g = document.createElement('script');
        g.src = 'https://www.googletagmanager.com/gtag/js?id=G-JHSDCEZ9EK';
        g.async = true;
        document.head.appendChild(g);
        g.onload = function () {
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', 'G-JHSDCEZ9EK');
        };
      }
    }

    document.addEventListener("click", function (e) {
      if (e.target && e.target.id === "cookie-accept") {
        localStorage.setItem("cookie-consent", "accepted");
        var banner = document.getElementById("cookie-consent");
        if (banner) banner.classList.add("hidden");
        loadAnalytics();
      }

      if (e.target && e.target.id === "cookie-reject") {
        localStorage.setItem("cookie-consent", "rejected");
        var banner = document.getElementById("cookie-consent");
        if (banner) banner.classList.add("hidden");
      }
    });
  })();
</script>
