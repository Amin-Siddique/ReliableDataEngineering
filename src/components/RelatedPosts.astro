---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";

interface Props {
  currentPost: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
  maxPosts?: number;
}

const { currentPost, allPosts, maxPosts = 3 } = Astro.props;

// Find related posts by matching tags
const currentTags = currentPost.data.tags;

const relatedPosts = allPosts
  .filter(post => post.id !== currentPost.id && !post.data.draft)
  .map(post => {
    const matchingTags = post.data.tags.filter(tag => currentTags.includes(tag));
    return { post, score: matchingTags.length };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, maxPosts)
  .map(({ post }) => post);
---

{relatedPosts.length > 0 && (
  <div class="related-posts">
    <h3 class="related-title text-foreground">Related Articles</h3>
    <div class="related-grid">
      {relatedPosts.map(post => (
        <a href={getPath(post.id, post.filePath)} class="related-card">
          {post.data.ogImage && (
            <img
              src={typeof post.data.ogImage === "string" ? post.data.ogImage : post.data.ogImage.src}
              alt={post.data.title}
              class="related-image"
            />
          )}
          <div class="related-content">
            <h4 class="related-post-title text-foreground">{post.data.title}</h4>
            <p class="related-description text-foreground/70">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .related-posts {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color, #374151);
  }

  .related-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--heading-color, #f3f4f6);
  }

  .related-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  .related-card {
    display: flex;
    flex-direction: column;
    background: var(--card-bg, #111827);
    border: 1px solid var(--border-color, #374151);
    border-radius: 0.5rem;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .related-card:hover {
    border-color: var(--accent-color, #3b82f6);
  }

  .related-image {
    width: 100%;
    height: 120px;
    object-fit: cover;
  }

  .related-content {
    padding: 1rem;
  }

  .related-post-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--heading-color, #f3f4f6);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .related-description {
    font-size: 0.8125rem;
    color: var(--text-muted, #9ca3af);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
