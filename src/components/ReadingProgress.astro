---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="reading-progress-tracker" data-progress-slug={slug}></div>

<script>
  function initReadingProgress() {
    const trackers = document.querySelectorAll<HTMLDivElement>("[data-progress-slug]:not([data-rp-initialized])");

    trackers.forEach(tracker => {
      tracker.dataset.rpInitialized = "true";

      const slug = tracker.dataset.progressSlug;
      if (!slug) return;

      let lastReportedProgress = 0;
      let debounceTimer: ReturnType<typeof setTimeout> | null = null;

      function reportProgress(progress: number) {
        if (!window.__authUser) return;
        // Only report in 10% increments
        const rounded = Math.round(progress * 10) / 10;
        if (rounded <= lastReportedProgress) return;
        lastReportedProgress = rounded;

        fetch("/api/reading-history", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ slug, progress: rounded }),
        }).catch(() => {});
      }

      function onScroll() {
        const article = document.getElementById("article");
        if (!article) return;

        const rect = article.getBoundingClientRect();
        const articleTop = rect.top + window.scrollY;
        const articleHeight = rect.height;
        const scrollPos = window.scrollY + window.innerHeight;
        const progress = Math.min(1, Math.max(0, (scrollPos - articleTop) / articleHeight));

        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => reportProgress(progress), 2000);
      }

      // Start tracking once auth is ready
      function startTracking() {
        if (!window.__authUser) return;
        window.addEventListener("scroll", onScroll, { passive: true });
        // Report initial position
        onScroll();
      }

      window.addEventListener("auth:ready", startTracking);
      if (window.__authUser) startTracking();
    });
  }

  document.addEventListener("astro:page-load", initReadingProgress);
</script>
