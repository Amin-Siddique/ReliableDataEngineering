---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import { INTERVIEW_APP, INTERVIEW_BASE, LEARN_TRACKS, PRACTICE_TRACKS } from "@/utils/interview";

const all = await getCollection("interview");
const inFolder = (id: string) => all.filter(e => e.id.startsWith(`${id}/`) && e.data.type !== "index");
const count = (id: string) => inFolder(id).length;
const qaBanks = all.filter(e => e.data.type === "qa");
const questions = qaBanks.reduce((n, e) => n + (e.body?.match(/<details>/g)?.length ?? 0), 0);
const runnable = count("practice/sql") + count("practice/python") + count("practice/algorithms");
const designs = count("practice/system-design") + count("practice/data-modeling") + count("practice/spark");
const lessons = LEARN_TRACKS.reduce((n, t) => n + count(t.id), 0);
const stats = [
  { n: lessons, label: "lessons" },
  { n: runnable, label: "runnable problems" },
  { n: designs, label: "design case studies" },
  { n: questions, label: "interview questions" },
];
const featured = ["practice/system-design/clickstream-analytics", "practice/system-design/usage-metering-billing",
  "learn/system-design/05-hot-keys", "learn/spark-databricks/03-shuffle-spill-salting", "practice/algorithms/02-minimum-window-substring"]
  .map(id => all.find(e => e.id === id))
  .filter(e => e !== undefined);
---

<Layout
  title={`Data Engineering Interview Prep | ${SITE.title}`}
  description="Free interview preparation for senior data engineers: system design with diagrams, runnable SQL and Python problems, data modeling case studies and spaced-repetition Q&A."
>
  <Header />
  <main id="main-content" class="app-layout pb-12" data-pagefind-body>
    <section class="mt-8 overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-accent/15 via-background to-background p-6 sm:p-10">
      <p class="text-xs font-semibold tracking-widest text-accent uppercase">Free · no account needed</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl">Data Engineering Interview Prep</h1>
      <p class="mt-4 max-w-3xl text-lg text-foreground/80">
        A study platform for senior data engineering interviews: system design with real diagrams, SQL and Python that
        run and auto-check in your browser, a step-by-step Python debugger, algorithms by pattern, Spark and Databricks
        deep dives, and long-form model answers to the questions that decide senior loops.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={INTERVIEW_APP} class="rounded-lg bg-accent px-5 py-2.5 font-semibold text-background shadow-sm hover:opacity-90">
          Open the interactive app
        </a>
        <a href={`${INTERVIEW_BASE}/learn/system-design/01-interview-framework/`} class="rounded-lg border border-border bg-background px-5 py-2.5 font-medium hover:border-accent hover:text-accent">
          Start with the system design framework
        </a>
      </div>
      <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {stats.map(s => (
          <div class="rounded-xl border border-border bg-background/70 p-4">
            <dt class="text-xs text-foreground/60">{s.label}</dt>
            <dd class="mt-1 text-2xl font-bold">{s.n}+</dd>
          </div>
        ))}
      </dl>
      <p class="mt-6 text-sm text-foreground/60">
        Your progress (solved problems, flashcard schedule, notes) is saved only in your own browser and never sent to a
        server. Clearing your browser data resets it; the app's Progress page lets you export a backup.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="border-b border-border pb-2 text-2xl font-semibold">1. Learn the concepts</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {LEARN_TRACKS.map(t => (
          <a href={`${INTERVIEW_BASE}/${t.id}/`} class="rounded-xl border border-border p-5 transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md">
            <h3 class="font-semibold">{t.title}</h3>
            <p class="mt-1 text-sm text-foreground/70">{t.desc}</p>
            <p class="mt-2 text-xs text-foreground/50">{count(t.id)} lessons</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="border-b border-border pb-2 text-2xl font-semibold">2. Practise</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {PRACTICE_TRACKS.map(t => (
          <a href={`${INTERVIEW_BASE}/${t.id}/`} class="rounded-xl border border-border p-5 transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md">
            <h3 class="font-semibold">{t.title}</h3>
            <p class="mt-1 text-sm text-foreground/70">{t.desc}</p>
            <p class="mt-2 text-xs text-foreground/50">{count(t.id)} problems</p>
          </a>
        ))}
      </div>
      {featured.length > 0 && (
        <p class="mt-4 text-sm text-foreground/70">
          Popular:{" "}
          {featured.map((e, i) => (
            <>
              {i > 0 && " · "}
              <a class="text-accent hover:underline" href={`${INTERVIEW_BASE}/${e.id}/`}>{e.data.title}</a>
            </>
          ))}
        </p>
      )}
    </section>

    <section class="mt-12">
      <h2 class="border-b border-border pb-2 text-2xl font-semibold">3. Drill interview questions</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {qaBanks
          .filter(e => e.id.split("/").length === 2)
          .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
          .map(e => (
            <a href={`${INTERVIEW_BASE}/${e.id}/`} class="rounded-xl border border-border p-5 transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md">
              <h3 class="font-semibold">{e.data.title}</h3>
              <p class="mt-1 text-sm text-foreground/70">{e.data.description}</p>
            </a>
          ))}
      </div>
      <p class="mt-4 text-sm text-foreground/70">
        Also: <a class="text-accent hover:underline" href={`${INTERVIEW_BASE}/interview-qa/resume-grilling/sample-answers/`}>resume grilling worked example</a> ·
        <a class="text-accent hover:underline" href={`${INTERVIEW_BASE}/interview-qa/behavioral/questions-by-category/`}>behavioral questions</a>
      </p>
    </section>
  </main>
  <Footer />
</Layout>
