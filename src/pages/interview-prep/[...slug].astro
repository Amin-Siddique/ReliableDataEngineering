---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import MermaidRenderer from "@/components/interview/MermaidRenderer.astro";
import { SITE } from "@/config";
import {
  INTERVIEW_BASE,
  INTERVIEW_REPO,
  appUrl,
  entryUrl,
  parentIndexId,
  repoPath,
  siblings,
  type InterviewEntry,
} from "@/utils/interview";

export async function getStaticPaths() {
  const entries = await getCollection("interview");
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: InterviewEntry };
const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const all = await getCollection("interview");
const byId = new Map(all.map(e => [e.id, e]));
const parent = byId.get(parentIndexId(entry));
const grandparent = parent ? byId.get(parentIndexId(parent)) : undefined;
const list = data.type === "index" ? [] : siblings(entry, all);
const idx = list.findIndex(e => e.id === entry.id);
const prev = idx > 0 ? list[idx - 1] : undefined;
const next = idx >= 0 && idx < list.length - 1 ? list[idx + 1] : undefined;

const kind = { learn: "Lesson", practice: "Practice problem", qa: "Interview Q&A", index: "Overview" }[data.type];
const topics = [...(data.topics ?? data.tags ?? [])].slice(0, 5);
const isRunnable = data.type === "practice" && (data.section === "sql" || data.section === "python");
const cta =
  data.type === "qa"
    ? "Study as flashcards"
    : isRunnable
      ? `Solve it in the browser (${data.section === "sql" ? "SQL" : "Python"} editor)`
      : data.type === "practice"
        ? "Practise with timer, notes and rubric"
        : "Open in the interactive app";
const sourceUrl = `${INTERVIEW_REPO}/blob/main/${repoPath(entry)}`;
---

<Layout title={`${data.title} | Interview Prep | ${SITE.title}`} description={data.description}>
  <Header />
  <main id="main-content" class="app-layout pb-12">
    <nav class="mt-6 text-sm text-foreground/70" aria-label="Breadcrumb">
      <a class="hover:text-accent" href={`${INTERVIEW_BASE}/`}>Interview Prep</a>
      {grandparent && grandparent.id !== parent?.id && (
        <>
          <span class="mx-1">/</span>
          <a class="hover:text-accent" href={entryUrl(grandparent)}>{grandparent.data.title}</a>
        </>
      )}
      {parent && parent.id !== entry.id && (
        <>
          <span class="mx-1">/</span>
          <a class="hover:text-accent" href={entryUrl(parent)}>{parent.data.title}</a>
        </>
      )}
    </nav>

    <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full border border-border px-2 py-0.5 font-semibold">{kind}</span>
      {data.difficulty && (
        <span class="rounded-full border border-border px-2 py-0.5 font-semibold text-accent">{data.difficulty}</span>
      )}
      {topics.map(t => (
        <span class="rounded-full border border-border px-2 py-0.5 text-foreground/70">{t}</span>
      ))}
    </div>

    <div class="mt-4 flex flex-wrap gap-3">
      {data.type !== "index" && (
        <a
          href={appUrl(entry)}
          class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-background hover:opacity-90"
        >
          {cta}
        </a>
      )}
      <a
        href={sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-accent hover:text-accent"
      >
        Suggest an improvement on GitHub
      </a>
    </div>

    <article data-pagefind-body class="app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)">
      <Content />
    </article>

    {(prev || next) && (
      <nav class="mt-12 flex flex-col gap-3 border-t border-border pt-6 sm:flex-row sm:justify-between" aria-label="Pagination">
        <div>
          {prev && (
            <a class="hover:text-accent" href={entryUrl(prev)}>
              <span class="block text-xs text-foreground/60">Previous</span>
              {prev.data.title}
            </a>
          )}
        </div>
        <div class="sm:text-right">
          {next && (
            <a class="hover:text-accent" href={entryUrl(next)}>
              <span class="block text-xs text-foreground/60">Next</span>
              {next.data.title}
            </a>
          )}
        </div>
      </nav>
    )}
  </main>
  <MermaidRenderer />
  <Footer />
</Layout>
