---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={`Reading List | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout py-12">
    <h1 class="text-2xl font-bold text-accent sm:text-3xl mb-2">Reading List</h1>
    <p class="text-muted mb-8">Articles you've saved to read later</p>

    <div id="reading-list" class="space-y-4">
      <p class="text-muted">Loading your saved articles...</p>
    </div>

    <div id="empty-state" class="hidden text-center py-12">
      <svg class="mx-auto w-16 h-16 text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
      </svg>
      <h2 class="text-lg font-medium mb-2">No saved articles</h2>
      <p class="text-muted">Click the "Save" button on any article to add it to your reading list.</p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .bookmark-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: var(--card-bg, #111827);
    border: 1px solid var(--border-color, #374151);
    border-radius: 0.5rem;
  }

  .bookmark-item:hover {
    border-color: var(--accent-color, #3b82f6);
  }

  .bookmark-link {
    flex: 1;
    text-decoration: none;
  }

  .bookmark-title {
    font-weight: 500;
    color: var(--heading-color, #f3f4f6);
  }

  .bookmark-date {
    font-size: 0.75rem;
    color: var(--text-muted, #6b7280);
    margin-top: 0.25rem;
  }

  .remove-btn {
    padding: 0.5rem;
    background: transparent;
    border: none;
    color: var(--text-muted, #6b7280);
    cursor: pointer;
    transition: color 0.2s;
  }

  .remove-btn:hover {
    color: #ef4444;
  }
</style>

<script>
  interface Bookmark {
    slug: string;
    title: string;
    savedAt: string;
  }

  function getBookmarks(): Bookmark[] {
    try {
      return JSON.parse(localStorage.getItem("bookmarks") || "[]");
    } catch {
      return [];
    }
  }

  function saveBookmarks(bookmarks: Bookmark[]) {
    localStorage.setItem("bookmarks", JSON.stringify(bookmarks));
  }

  function formatDate(dateStr: string): string {
    return new Date(dateStr).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  }

  function renderReadingList() {
    const container = document.getElementById("reading-list");
    const emptyState = document.getElementById("empty-state");
    if (!container || !emptyState) return;

    const bookmarks = getBookmarks();

    if (bookmarks.length === 0) {
      container.classList.add("hidden");
      emptyState.classList.remove("hidden");
      return;
    }

    container.classList.remove("hidden");
    emptyState.classList.add("hidden");

    container.innerHTML = bookmarks
      .map(
        (bookmark, index) => `
      <div class="bookmark-item" data-index="${index}">
        <a href="/posts/${bookmark.slug}" class="bookmark-link">
          <div class="bookmark-title">${bookmark.title}</div>
          <div class="bookmark-date">Saved ${formatDate(bookmark.savedAt)}</div>
        </a>
        <button class="remove-btn" aria-label="Remove from reading list" data-index="${index}">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    `
      )
      .join("");

    // Add remove handlers
    container.querySelectorAll<HTMLButtonElement>(".remove-btn").forEach(btn => {
      btn.addEventListener("click", e => {
        e.preventDefault();
        const index = parseInt(btn.dataset.index || "0");
        const bookmarks = getBookmarks();
        bookmarks.splice(index, 1);
        saveBookmarks(bookmarks);
        renderReadingList();
      });
    });
  }

  document.addEventListener("astro:page-load", renderReadingList);
</script>
