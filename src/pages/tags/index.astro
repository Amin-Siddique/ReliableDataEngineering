---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import { slugifyStr } from "@/utils/slugify";

const posts = await getCollection("blog", ({ data }) => !data.draft);

// Count tags
const tagCounts = new Map<string, number>();
posts.forEach(post => {
  post.data.tags.forEach(tag => {
    const count = tagCounts.get(tag) || 0;
    tagCounts.set(tag, count + 1);
  });
});

// Sort by count (descending), then alphabetically
const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1];
  return a[0].localeCompare(b[0]);
});
---

<Layout title={`Tags | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout py-12">
    <h1 class="text-2xl font-bold text-accent sm:text-3xl mb-2">Tags</h1>
    <p class="text-muted mb-8">Browse articles by topic</p>

    <div class="tags-cloud">
      {sortedTags.map(([tag, count]) => (
        <a
          href={`/tags/${slugifyStr(tag)}`}
          class="tag-item"
          style={`--size: ${Math.min(1 + count * 0.1, 1.5)}`}
        >
          <span class="tag-name">{tag}</span>
          <span class="tag-count">{count}</span>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--card-bg, #111827);
    border: 1px solid var(--border-color, #374151);
    border-radius: 9999px;
    text-decoration: none;
    font-size: calc(var(--size, 1) * 0.875rem);
    transition: all 0.2s;
  }

  .tag-item:hover {
    border-color: var(--accent-color, #3b82f6);
    background: var(--accent-color, #3b82f6);
  }

  .tag-item:hover .tag-name,
  .tag-item:hover .tag-count {
    color: white;
  }

  .tag-name {
    color: var(--heading-color, #f3f4f6);
    font-weight: 500;
  }

  .tag-count {
    color: var(--text-muted, #6b7280);
    font-size: 0.75rem;
    background: var(--border-color, #374151);
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
  }
</style>
