---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={`Activity | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">

    <div id="activity-auth-prompt" class="hidden activity-center">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" class="activity-center-icon">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <p>Sign in to see your activity.</p>
      <a href="/api/auth/google" class="activity-sign-in">Sign in</a>
    </div>

    <div id="activity-loading" class="activity-center">
      <p>Loading your activity...</p>
    </div>

    <div id="activity-content" class="hidden">
      <!-- Profile summary -->
      <div class="activity-profile">
        <img id="activity-avatar" src="" alt="" width="56" height="56" class="activity-profile-img" />
        <div class="activity-profile-info">
          <h1 id="activity-name" class="activity-profile-name"></h1>
          <p id="activity-email" class="activity-profile-email"></p>
        </div>
        <a href="/profile" class="activity-edit-link">Edit profile</a>
      </div>

      <!-- Stats bar -->
      <div class="activity-stats">
        <a href="/history" class="activity-stat">
          <span id="activity-stat-read" class="activity-stat-num">0</span>
          <span class="activity-stat-label">Articles Read</span>
        </a>
        <a href="/bookmarks" class="activity-stat">
          <span id="activity-stat-bookmarks" class="activity-stat-num">0</span>
          <span class="activity-stat-label">Bookmarks</span>
        </a>
        <a href="/notifications" class="activity-stat">
          <span id="activity-stat-notifs" class="activity-stat-num">0</span>
          <span class="activity-stat-label">Notifications</span>
        </a>
        <div class="activity-stat">
          <span id="activity-stat-comments" class="activity-stat-num">0</span>
          <span class="activity-stat-label">Comments</span>
        </div>
      </div>

      <!-- Tabs -->
      <div class="activity-tabs">
        <button class="activity-tab active" data-tab="recent">Recent Activity</button>
        <button class="activity-tab" data-tab="bookmarks">Bookmarks</button>
        <button class="activity-tab" data-tab="history">Reading History</button>
      </div>

      <!-- Tab panels -->
      <div id="tab-recent" class="activity-panel">
        <div id="recent-list" class="activity-list">
          <p class="activity-empty">No recent activity.</p>
        </div>
      </div>

      <div id="tab-bookmarks" class="activity-panel hidden">
        <div id="bookmarks-list" class="activity-list">
          <p class="activity-empty">No bookmarks yet. Save articles while reading.</p>
        </div>
      </div>

      <div id="tab-history" class="activity-panel hidden">
        <div id="history-list" class="activity-list">
          <p class="activity-empty">No reading history yet.</p>
        </div>
      </div>
    </div>

  </main>
  <Footer />
</Layout>

<style is:global>
  .activity-center {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--foreground);
    opacity: 0.6;
  }

  .activity-center-icon {
    margin: 0 auto 1rem;
    opacity: 0.3;
  }

  .activity-sign-in {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem 1.5rem;
    background: var(--accent);
    color: var(--background);
    border-radius: 0.375rem;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .activity-profile {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .activity-profile-img {
    border-radius: 50%;
    border: 2px solid var(--border);
    object-fit: cover;
    flex-shrink: 0;
  }

  .activity-profile-info {
    flex: 1;
    min-width: 0;
  }

  .activity-profile-name {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--foreground);
    line-height: 1.3;
  }

  .activity-profile-email {
    font-size: 0.8125rem;
    color: var(--foreground);
    opacity: 0.5;
    margin-top: 0.125rem;
  }

  .activity-edit-link {
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .activity-edit-link:hover {
    text-decoration: underline;
  }

  .activity-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .activity-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0.5rem;
    text-decoration: none;
    color: var(--foreground);
    transition: background 0.15s;
    border-right: 1px solid var(--border);
  }

  .activity-stat:last-child {
    border-right: none;
  }

  a.activity-stat:hover {
    background: var(--muted);
  }

  .activity-stat-num {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  .activity-stat-label {
    font-size: 0.6875rem;
    opacity: 0.5;
    margin-top: 0.375rem;
    text-align: center;
  }

  .activity-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0;
  }

  .activity-tab {
    padding: 0.75rem 1.25rem;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    opacity: 0.5;
    cursor: pointer;
    transition: all 0.2s;
  }

  .activity-tab:hover {
    opacity: 0.8;
  }

  .activity-tab.active {
    opacity: 1;
    border-bottom-color: var(--accent);
    color: var(--accent);
  }

  .activity-panel {
    min-height: 200px;
  }

  .activity-list {
    display: flex;
    flex-direction: column;
  }

  .activity-empty {
    padding: 3rem 1rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--foreground);
    opacity: 0.4;
  }

  .activity-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--foreground);
    transition: background 0.1s;
  }

  .activity-item:hover {
    background: var(--muted);
    margin: 0 -0.5rem;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    border-radius: 0.375rem;
  }

  .activity-item-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .activity-item-icon.type-bookmark {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }

  .activity-item-icon.type-read {
    background: color-mix(in srgb, #22c55e 12%, transparent);
    color: #22c55e;
  }

  .activity-item-icon.type-notif {
    background: color-mix(in srgb, #f59e0b 12%, transparent);
    color: #f59e0b;
  }

  .activity-item-body {
    flex: 1;
    min-width: 0;
  }

  .activity-item-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .activity-item-meta {
    font-size: 0.6875rem;
    color: var(--foreground);
    opacity: 0.4;
    margin-top: 0.125rem;
  }

  .activity-item-badge {
    flex-shrink: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
  }

  .badge-done {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }

  .badge-progress {
    background: color-mix(in srgb, #f59e0b 12%, transparent);
    color: #f59e0b;
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  function initActivityPage() {
    const authPrompt = document.getElementById("activity-auth-prompt");
    const loading = document.getElementById("activity-loading");
    const content = document.getElementById("activity-content");

    if (!authPrompt || !loading || !content) return;

    function escapeHtml(text: string): string {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function slugToPath(slug: string): string {
      return `/posts/${slug}/`;
    }

    function slugToTitle(slug: string): string {
      return slug
        .replace(/^article_/, "")
        .replace(/\.md$/, "")
        .replace(/_/g, " ")
        .replace(/\b\w/g, l => l.toUpperCase());
    }

    function formatDate(dateStr: string): string {
      return new Date(dateStr).toLocaleDateString("en-US", {
        month: "short", day: "numeric",
      });
    }

    function formatTimeAgo(dateStr: string): string {
      const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
      if (diff < 60) return "just now";
      if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
      if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
      if (diff < 604800) return `${Math.floor(diff / 86400)}d ago`;
      return formatDate(dateStr);
    }

    // Tabs
    const tabs = content.querySelectorAll<HTMLButtonElement>(".activity-tab");
    const panels = content.querySelectorAll<HTMLDivElement>(".activity-panel");
    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        tabs.forEach(t => t.classList.remove("active"));
        panels.forEach(p => p.classList.add("hidden"));
        tab.classList.add("active");
        const panel = document.getElementById(`tab-${tab.dataset.tab}`);
        panel?.classList.remove("hidden");
      });
    });

    function onAuth(user: typeof window.__authUser) {
      loading?.classList.add("hidden");
      if (!user) {
        authPrompt?.classList.remove("hidden");
        return;
      }

      content?.classList.remove("hidden");

      // Profile info
      const avatarSrc = user.avatarUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(user.displayName)}&background=3b82f6&color=fff&size=112`;
      (document.getElementById("activity-avatar") as HTMLImageElement).src = avatarSrc;
      document.getElementById("activity-name")!.textContent = user.displayName;
      document.getElementById("activity-email")!.textContent = user.email || "";

      // Fetch all data in parallel
      Promise.all([
        fetch("/api/profile").then(r => r.json()),
        fetch("/api/bookmarks").then(r => r.json()),
        fetch("/api/reading-history").then(r => r.json()),
        fetch("/api/notifications?limit=10").then(r => r.json()),
      ]).then(([profileData, bookmarksData, historyData, notifsData]) => {
        const stats = profileData.stats || {};
        const bookmarks = bookmarksData.bookmarks || [];
        const history = historyData.history || [];
        const notifs = notifsData.notifications || [];
        const unreadCount = notifsData.unreadCount || 0;

        // Stats
        document.getElementById("activity-stat-read")!.textContent = (stats.articlesRead || 0).toString();
        document.getElementById("activity-stat-bookmarks")!.textContent = (stats.bookmarks || 0).toString();
        document.getElementById("activity-stat-notifs")!.textContent = unreadCount.toString();
        document.getElementById("activity-stat-comments")!.textContent = (stats.comments || 0).toString();

        // Recent activity (merge bookmarks, history, notifications - sorted by date)
        type Activity = { type: string; title: string; href: string; time: string; detail?: string };
        const activities: Activity[] = [];

        bookmarks.forEach((b: { post_slug: string; created_at: string }) => {
          activities.push({
            type: "bookmark",
            title: slugToTitle(b.post_slug),
            href: slugToPath(b.post_slug),
            time: b.created_at,
            detail: "Bookmarked",
          });
        });

        history.forEach((h: { post_slug: string; progress: number; last_read_at: string }) => {
          const pct = Math.round(h.progress * 100);
          activities.push({
            type: "read",
            title: slugToTitle(h.post_slug),
            href: slugToPath(h.post_slug),
            time: h.last_read_at,
            detail: pct >= 90 ? "Finished reading" : `Read ${pct}%`,
          });
        });

        notifs.forEach((n: { message: string; post_slug: string | null; created_at: string; type: string }) => {
          activities.push({
            type: "notif",
            title: n.message,
            href: n.post_slug ? slugToPath(n.post_slug) : "/notifications",
            time: n.created_at,
            detail: n.type === "reply" ? "Reply" : "Comment",
          });
        });

        activities.sort((a, b) => new Date(b.time).getTime() - new Date(a.time).getTime());

        // Render recent
        const recentList = document.getElementById("recent-list")!;
        if (activities.length === 0) {
          recentList.innerHTML = '<p class="activity-empty">No recent activity.</p>';
        } else {
          recentList.innerHTML = activities.slice(0, 15).map(a => {
            const iconClass = a.type === "bookmark" ? "type-bookmark" : a.type === "read" ? "type-read" : "type-notif";
            const emoji = a.type === "bookmark" ? "&#128278;" : a.type === "read" ? "&#128214;" : "&#128172;";
            return `
              <a href="${escapeHtml(a.href)}" class="activity-item">
                <div class="activity-item-icon ${iconClass}">${emoji}</div>
                <div class="activity-item-body">
                  <div class="activity-item-title">${escapeHtml(a.title)}</div>
                  <div class="activity-item-meta">${escapeHtml(a.detail || "")} &middot; ${formatTimeAgo(a.time)}</div>
                </div>
              </a>
            `;
          }).join("");
        }

        // Render bookmarks tab
        const bookmarksList = document.getElementById("bookmarks-list")!;
        if (bookmarks.length === 0) {
          bookmarksList.innerHTML = '<p class="activity-empty">No bookmarks yet. Save articles while reading.</p>';
        } else {
          bookmarksList.innerHTML = bookmarks.map((b: { post_slug: string; created_at: string }) => `
            <a href="${escapeHtml(slugToPath(b.post_slug))}" class="activity-item">
              <div class="activity-item-icon type-bookmark">&#128278;</div>
              <div class="activity-item-body">
                <div class="activity-item-title">${escapeHtml(slugToTitle(b.post_slug))}</div>
                <div class="activity-item-meta">Saved ${formatDate(b.created_at)}</div>
              </div>
            </a>
          `).join("");
        }

        // Render history tab
        const historyList = document.getElementById("history-list")!;
        if (history.length === 0) {
          historyList.innerHTML = '<p class="activity-empty">No reading history yet.</p>';
        } else {
          historyList.innerHTML = history.map((h: { post_slug: string; progress: number; last_read_at: string }) => {
            const pct = Math.round(h.progress * 100);
            const isComplete = pct >= 90;
            return `
              <a href="${escapeHtml(slugToPath(h.post_slug))}" class="activity-item">
                <div class="activity-item-icon type-read">&#128214;</div>
                <div class="activity-item-body">
                  <div class="activity-item-title">${escapeHtml(slugToTitle(h.post_slug))}</div>
                  <div class="activity-item-meta">Last read ${formatDate(h.last_read_at)}</div>
                </div>
                <span class="activity-item-badge ${isComplete ? "badge-done" : "badge-progress"}">${isComplete ? "Done" : pct + "%"}</span>
              </a>
            `;
          }).join("");
        }
      }).catch(() => {});
    }

    window.addEventListener("auth:ready", (e: Event) => onAuth((e as CustomEvent).detail));
    if (window.__authUser !== undefined) onAuth(window.__authUser);
  }

  document.addEventListener("astro:page-load", initActivityPage);
</script>
