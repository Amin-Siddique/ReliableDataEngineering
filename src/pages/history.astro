---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={`Reading History | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">
    <h1 class="text-3xl font-bold text-foreground mt-8 mb-2">Reading History</h1>
    <p class="text-foreground/70 mb-8 text-sm">Articles you have read and your progress.</p>

    <div id="history-auth-prompt" class="hidden text-center py-12">
      <p class="text-foreground/70 mb-4">Sign in to see your reading history.</p>
      <a href="/api/auth/google" class="inline-block rounded bg-accent px-6 py-2 text-sm font-medium text-background transition-opacity hover:opacity-90">
        Sign in
      </a>
    </div>

    <div id="history-loading" class="text-center py-12">
      <p class="text-foreground/70">Loading history...</p>
    </div>

    <div id="history-empty" class="hidden text-center py-12">
      <p class="text-foreground/70 mb-4">No reading history yet. Start reading to track your progress.</p>
      <a href="/posts" class="inline-block text-accent hover:underline">Browse articles</a>
    </div>

    <div id="history-list" class="hidden grid gap-3"></div>
  </main>
  <Footer />
</Layout>

<script>
  function initHistoryPage() {
    const authPrompt = document.getElementById("history-auth-prompt");
    const loading = document.getElementById("history-loading");
    const empty = document.getElementById("history-empty");
    const list = document.getElementById("history-list");

    if (!authPrompt || !loading || !empty || !list) return;

    function renderHistory(history: { post_slug: string; progress: number; last_read_at: string }[]) {
      loading?.classList.add("hidden");

      if (history.length === 0) {
        empty?.classList.remove("hidden");
        return;
      }

      if (!list) return;
      list.innerHTML = history.map(h => {
        const slug = h.post_slug;
        const path = `/posts/${slug}/`;
        const title = slug
          .replace(/^article_/, "")
          .replace(/\.md$/, "")
          .replace(/_/g, " ")
          .replace(/\b\w/g, l => l.toUpperCase());
        const date = new Date(h.last_read_at).toLocaleDateString("en-US", {
          year: "numeric", month: "short", day: "numeric"
        });
        const pct = Math.round(h.progress * 100);
        const isComplete = pct >= 90;

        return `
          <a href="${path}" class="history-card block p-4 border border-border rounded-lg hover:border-accent transition-colors">
            <div class="flex items-center justify-between gap-4">
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-foreground text-sm truncate">${title}</h3>
                <p class="text-foreground/50 text-xs mt-1">Last read ${date}</p>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                ${isComplete
                  ? '<span style="color:var(--accent);font-size:0.75rem;font-weight:600">Done</span>'
                  : `<div style="width:3rem;height:0.375rem;background:var(--border);border-radius:9999px;overflow:hidden">
                       <div style="width:${pct}%;height:100%;background:var(--accent);border-radius:9999px"></div>
                     </div>
                     <span style="font-size:0.7rem;color:var(--foreground);opacity:0.5">${pct}%</span>`
                }
              </div>
            </div>
          </a>
        `;
      }).join("");

      list?.classList.remove("hidden");
    }

    function onAuth(user: unknown) {
      loading?.classList.add("hidden");

      if (!user) {
        authPrompt?.classList.remove("hidden");
        return;
      }

      loading?.classList.remove("hidden");
      fetch("/api/reading-history")
        .then(res => res.json())
        .then(data => renderHistory(data.history || []))
        .catch(() => {
          loading?.classList.add("hidden");
          empty?.classList.remove("hidden");
        });
    }

    window.addEventListener("auth:ready", (e: Event) => onAuth((e as CustomEvent).detail));
    if (window.__authUser !== undefined) onAuth(window.__authUser);
  }

  document.addEventListener("astro:page-load", initHistoryPage);
</script>
