---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={`Highlights | ${SITE.title}`} noindex>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">
    <h1 class="hl-page-title">Your Highlights</h1>
    <p class="hl-page-desc">Passages you saved from articles, with your notes.</p>

    <div id="hl-auth-prompt" class="hidden hl-center">
      <p>Sign in to see your highlights.</p>
      <a href="/api/auth/google" class="hl-sign-in">Sign in</a>
    </div>

    <div id="hl-loading" class="hl-center">
      <p>Loading highlights...</p>
    </div>

    <div id="hl-empty" class="hidden hl-center">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity:0.15;margin-bottom:1rem">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
      </svg>
      <p>No highlights yet.</p>
      <p class="hl-sub">Select text in any article to start highlighting.</p>
    </div>

    <div id="hl-list" class="hidden"></div>
  </main>
  <Footer />
</Layout>

<style is:global>
  .hl-page-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--foreground);
    margin-top: 2rem;
    margin-bottom: 0.375rem;
  }

  .hl-page-desc {
    font-size: 0.875rem;
    color: var(--foreground);
    opacity: 0.5;
    margin-bottom: 2rem;
  }

  .hl-center {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--foreground);
    opacity: 0.6;
  }

  .hl-sub {
    font-size: 0.875rem;
    opacity: 0.6;
    margin-top: 0.375rem;
  }

  .hl-sign-in {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem 1.5rem;
    background: var(--accent);
    color: var(--background);
    border-radius: 0.375rem;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .hl-article-group {
    margin-bottom: 2rem;
  }

  .hl-article-link {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--foreground);
    text-decoration: none;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .hl-article-link:hover {
    color: var(--accent);
  }

  .hl-card {
    display: flex;
    gap: 0;
    padding: 0.875rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }

  .hl-card:last-child {
    border-bottom: none;
  }

  .hl-card-color {
    width: 4px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-right: 0.875rem;
  }

  .hl-card-color.c-yellow { background: #fde68a; }
  .hl-card-color.c-green { background: #86efac; }
  .hl-card-color.c-blue { background: #93c5fd; }
  .hl-card-color.c-pink { background: #f9a8d4; }
  .hl-card-color.c-purple { background: #c4b5fd; }

  .hl-card-body {
    flex: 1;
    min-width: 0;
  }

  .hl-card-text {
    font-size: 0.875rem;
    color: var(--foreground);
    line-height: 1.5;
    opacity: 0.85;
  }

  .hl-card-note {
    font-size: 0.8125rem;
    color: var(--accent);
    margin-top: 0.375rem;
    line-height: 1.4;
    font-style: italic;
  }

  .hl-card-meta {
    font-size: 0.6875rem;
    color: var(--foreground);
    opacity: 0.35;
    margin-top: 0.375rem;
  }

  #main-content .hidden {
    display: none !important;
  }
</style>

<script>
  function initHighlightsPage() {
    const authPrompt = document.getElementById("hl-auth-prompt");
    const loading = document.getElementById("hl-loading");
    const empty = document.getElementById("hl-empty");
    const list = document.getElementById("hl-list");

    if (!authPrompt || !loading || !empty || !list) return;

    function escapeHtml(text: string): string {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function formatDate(dateStr: string): string {
      return new Date(dateStr).toLocaleDateString("en-US", {
        month: "short", day: "numeric",
      });
    }

    function slugToTitle(slug: string): string {
      return slug
        .replace(/^article_/, "")
        .replace(/\.md$/, "")
        .replace(/_/g, " ")
        .replace(/\b\w/g, l => l.toUpperCase());
    }

    interface Highlight {
      id: number;
      post_slug: string;
      selected_text: string;
      note: string | null;
      color: string;
      created_at: string;
    }

    function renderHighlights(highlights: Highlight[]) {
      loading?.classList.add("hidden");

      if (highlights.length === 0) {
        empty?.classList.remove("hidden");
        return;
      }

      // Group by post
      const groups = new Map<string, Highlight[]>();
      highlights.forEach(h => {
        const arr = groups.get(h.post_slug) || [];
        arr.push(h);
        groups.set(h.post_slug, arr);
      });

      let html = "";
      groups.forEach((items, postSlug) => {
        const href = `/posts/${postSlug}/`;
        const title = slugToTitle(postSlug);

        html += `<div class="hl-article-group">`;
        html += `<a href="${escapeHtml(href)}" class="hl-article-link">${escapeHtml(title)}</a>`;

        items.forEach(h => {
          html += `
            <div class="hl-card">
              <div class="hl-card-color c-${h.color}"></div>
              <div class="hl-card-body">
                <div class="hl-card-text">"${escapeHtml(h.selected_text)}"</div>
                ${h.note ? `<div class="hl-card-note">${escapeHtml(h.note)}</div>` : ""}
                <div class="hl-card-meta">${formatDate(h.created_at)}</div>
              </div>
            </div>
          `;
        });

        html += `</div>`;
      });

      list!.innerHTML = html;
      list?.classList.remove("hidden");
    }

    function onAuth(user: unknown) {
      loading?.classList.add("hidden");
      if (!user) {
        authPrompt?.classList.remove("hidden");
        return;
      }

      loading?.classList.remove("hidden");
      fetch("/api/highlights")
        .then(res => res.json())
        .then(data => renderHighlights(data.highlights || []))
        .catch(() => {
          loading?.classList.add("hidden");
          empty?.classList.remove("hidden");
        });
    }

    window.addEventListener("auth:ready", (e: Event) => onAuth((e as CustomEvent).detail));
    if (window.__authUser !== undefined) onAuth(window.__authUser);
  }

  document.addEventListener("astro:page-load", initHighlightsPage);
</script>
