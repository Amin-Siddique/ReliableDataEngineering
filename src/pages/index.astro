---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import TrendingPosts from "@/components/TrendingPosts.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import WelcomeBanner from "@/components/WelcomeBanner.astro";
import ContinueReading from "@/components/ContinueReading.astro";
import AdUnit from "@/components/AdUnit.astro";
import getSortedPosts from "@/utils/getSortedPosts";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
const feedPosts = sortedPosts.filter(p => p !== featuredPost);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <WelcomeBanner />
    <ContinueReading />

    <div class="homepage-grid">
      <!-- Main feed column -->
      <div class="feed-column">
        {featuredPost && (
          <ArticleCard post={featuredPost} featured />
        )}

        <div class="feed-list">
          {feedPosts.map(post => (
            <ArticleCard post={post} />
          ))}
        </div>

        <AdUnit slot="footer" class="my-8" />
      </div>

      <!-- Sidebar -->
      <aside class="sidebar-column">
        <div class="sidebar-sticky">
          <TrendingPosts posts={sortedPosts} />

          <div class="sidebar-divider" />

          <NewsletterSignup />
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .homepage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-top: 2rem;
  }

  @media (min-width: 1024px) {
    .homepage-grid {
      grid-template-columns: 1fr 320px;
      gap: 3rem;
    }
  }

  .feed-column {
    min-width: 0;
  }

  .feed-list {
    display: flex;
    flex-direction: column;
  }

  .sidebar-column {
    display: none;
  }

  @media (min-width: 1024px) {
    .sidebar-column {
      display: block;
      border-left: 1px solid var(--border);
      padding-left: 2rem;
    }
  }

  .sidebar-sticky {
    position: sticky;
    top: 2rem;
  }

  .sidebar-divider {
    border-top: 1px solid var(--border);
    margin: 1.5rem 0;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
